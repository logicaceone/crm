POSTGRES_DB=admin_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://admin:changeme@postgres:5432/admin_db
SECRET_KEY=changeme
CORS_ORIGIN=http://localhost:5173
TELEGRAM_BOT_TOKEN=

# Telegram daily report — sent at 23:55 in REPORT_TIMEZONE
# REPORT_BOT_TOKEN — token for the reporting bot. Leave empty to reuse
#                   TELEGRAM_BOT_TOKEN.
# REPORT_CHAT_ID   — numeric chat id of the target group. Add the bot
#                   as an admin to the group, write a message there,
#                   then open https://api.telegram.org/bot<TOKEN>/getUpdates
#                   and grab "chat":{"id": ...}.
# REPORT_TIMEZONE  — IANA tz, default Europe/Moscow.
REPORT_BOT_TOKEN=
REPORT_CHAT_ID=
REPORT_TIMEZONE=Europe/Moscow

# Daily DB backup — pg_dump → gzip → sendDocument to a Telegram chat.
# Uses REPORT_BOT_TOKEN (with TELEGRAM_BOT_TOKEN fallback) for sending.
# Chat id can also be set through the UI (Настройки → Резервные копии).
# Files live in the /backups volume; older than BACKUP_KEEP_DAYS get
# trimmed automatically.
BACKUP_ENABLED=true
BACKUP_TELEGRAM_CHAT_ID=
BACKUP_KEEP_DAYS=30
