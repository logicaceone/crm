# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/crm

# Session signing key for itsdangerous — generate a random 64+ char string
SECRET_KEY=change-me-to-a-long-random-string

# CORS allowed origins for the SPA. Comma-separated list — extra
# whitespace around commas is tolerated. Examples:
#   single:    CORS_ORIGINS=https://crm-admin.example.com
#   multiple:  CORS_ORIGINS=http://localhost:5173,https://crm-admin.example.com
CORS_ORIGINS=https://crm-admin.example.com

# Telegram bot token used for CPA tracking (createChatInviteLink + getChatInviteLink)
# Optional — leave blank to disable Telegram CPA. Token can also be set via /settings UI.
TELEGRAM_BOT_TOKEN=

# Max.ru platform API
MAX_API_BASE_URL=https://platform-api.max.ru
MAX_POSTS_SAMPLE=20

# ─────────────────────────────────────────────────────────────────────────────
# Telegram CPA troubleshooting
#
# If CPA sync is not working, check whether a webhook is active on the bot:
#   GET https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/getWebhookInfo
#
# Remove it via the admin endpoint:
#   POST /api/settings/telegram/delete-webhook   (root only)
# Or directly via Telegram Bot API:
#   POST https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/deleteWebhook
#
# A webhook set in BotFather causes getUpdates to return 409 Conflict.
# After the switch to getChatInviteLink the sync itself no longer breaks,
# but the app will log a startup warning if a webhook is detected because
# it usually indicates a misconfiguration of the bot.
